{
  "name": "sadmin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api-types": "openapi-typescript ../Back/openapi.json -o src/lib/api-types.ts",
    "api-types:check": "node -e \"const{execSync}=require('child_process');const fs=require('fs');const a=fs.readFileSync('src/lib/api-types.ts','utf8');execSync('npm run gen:api-types',{stdio:'ignore'});const b=fs.readFileSync('src/lib/api-types.ts','utf8');if(a!==b){console.error('api-types.ts estava DESATUALIZADO — foi regenerado agora, confira o diff e commite.');process.exit(1)}console.log('api-types.ts em dia com ../Back/openapi.json')\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
